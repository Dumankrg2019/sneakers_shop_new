<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginEnd="21dp">
        <ImageView
            android:id="@+id/ivPicture"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:src="@drawable/item01"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_image"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TinyGreyText"
            android:text="@string/entrepeneur"
            android:layout_gravity="top"
            android:background="@drawable/bg_texviewt"
            android:padding="4dp"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TinyText"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:text="@string/material_design"/>
        <TextView
            android:id="@+id/tvAuthorAndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TinyGreyText"
            android:text="@string/material_design"
            android:layout_marginTop="8dp"
            android:layout_gravity="bottom"/>

    </LinearLayout>
</LinearLayout>